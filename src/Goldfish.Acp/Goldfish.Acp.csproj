<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Goldfish.Acp</AssemblyName>
    <RootNamespace>Goldfish.Acp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Protocol/schema.json" LogicalName="Goldfish.Acp.Protocol.schema.v1.json" />
    <EmbeddedResource Include="Protocol/meta.json" LogicalName="Goldfish.Acp.Protocol.meta.v1.json" />
    <None Include="Protocol/manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Protocol/LICENSE" Pack="true" PackagePath="licenses/ACP-LICENSE" />
  </ItemGroup>

</Project>
